  title: Layers Lamp
  tagline: 'A build-it-yourself lamp for my light design workshop: layers of laser-cut acrylic around a glowing globe.'
  year: 
  category: "Lighting \xB7 Workshop kit"
  cover: {fileID: 21300000, guid: 1da94288d3fba66468bcbf717b10af88, type: 3}
